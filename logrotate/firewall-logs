# /etc/logrotate.d/firewall-logs
#
# Daily rotation for firewall devices under /var/log/firewall/
# Covers: cisco-asa, cisco-ftd, fortigate
#
# Firewall logs are retained for 365 days (1 year) to support security
# audits and compliance requirements. Adjust 'rotate' to suit your policy.
#
# File lifecycle:
#   rsyslog writes  →  <hostname>_current.log
#   logrotate renames →  <hostname>_current_YYYY-MM-DD.log
#   postrotate renames →  <hostname>_YYYY-MM-DD.log
#   next rotation    →  <hostname>_YYYY-MM-DD.log.gz
#
# Retention: 365 days

/var/log/firewall/*/*/*_current.log
{
    daily
    rotate 365
    compress
    delaycompress
    missingok
    notifempty
    create 0640 syslog adm
    sharedscripts
    dateext
    dateformat _%Y-%m-%d
    extension .log

    postrotate
        find /var/log/firewall -name '*_current_*.log' 2>/dev/null | \
        while IFS= read -r f; do
            newname=$(echo "$f" | sed 's/_current_/_/')
            mv -- "$f" "$newname"
        done
        systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
