# /etc/logrotate.d/vm-logs
#
# Daily rotation for virtual machines under /var/log/vms/
# Covers: linux, windows
#
# File lifecycle:
#   rsyslog writes  →  <hostname>_current.log
#   logrotate renames →  <hostname>_current_YYYY-MM-DD.log
#   postrotate renames →  <hostname>_YYYY-MM-DD.log
#   next rotation    →  <hostname>_YYYY-MM-DD.log.gz
#
# Retention: 90 days

/var/log/vms/*/*/*_current.log
{
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    create 0640 syslog adm
    sharedscripts
    dateext
    dateformat _%Y-%m-%d
    extension .log

    postrotate
        find /var/log/vms -name '*_current_*.log' 2>/dev/null | \
        while IFS= read -r f; do
            newname=$(echo "$f" | sed 's/_current_/_/')
            mv -- "$f" "$newname"
        done
        systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
