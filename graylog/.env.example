# Graylog environment configuration
# Copy this file to .env and fill in the values before running docker compose.

# ── IP of the host running Graylog ───────────────────────────────────────────
# Used to build the external URI that your browser connects to.
GRAYLOG_HOST_IP=192.168.1.100

# ── Secret pepper for password hashing (min 16 characters, random string) ────
# Generate one:  pwgen -N 1 -s 96
# or:            tr -dc A-Za-z0-9 </dev/urandom | head -c 96
GRAYLOG_PASSWORD_SECRET=changeme_replace_with_a_long_random_string_at_least_16_chars

# ── Admin password (SHA-256 hash of your chosen password) ────────────────────
# Generate:  echo -n "YourChosenPassword" | sha256sum | cut -d" " -f1
# Default below = hash of "admin" — CHANGE THIS before deploying.
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
